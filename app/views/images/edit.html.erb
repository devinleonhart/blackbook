
<section id="images-edit-view" class="bb-page">

  <div class="bb-container">
    <div class="bb-layout-sidebar">
      <!-- Left Sidebar -->
      <div class="bb-sidebar--wide order-2 lg:order-1">
        <div class="bb-card bb-card--panel">

      <%# Characters that appear in this image %>
      <% if @image.universe.characters.empty? %>
        <h1>There are no characters in this universe.</h1>
      <% else %>

        <!-- Characters currently in this image -->
        <h2 class="bb-section-heading--sm">Characters in this image</h2>
        <%= render "appearances", image: @image %>

        <!-- Add characters to this image (type-ahead, multi-select) -->
        <%= render "character_picker", image: @image, available_characters: @available_characters %>

      <% end %>

          <!-- Controls -->
          <div class="border-t pt-4 mt-4 space-y-2">
            <%= button_to universe_image_path(@image.universe, @image), method: :patch, params: { universe_id: @image.universe.id, image: { favorite: !@favorited } }, class: @favorited ? "bb-btn-sm bg-yellow-500 hover:bg-yellow-700 text-white w-full" : "bb-btn-sm bb-btn-primary w-full" do %>
              <%= @favorited ? "Unfavorite" : "Favorite" %>
            <% end %>
            <%= button_to "Delete image", universe_image_url(@image.universe, @image), method: :delete, data: { turbo_confirm: "Delete this image? This can't be undone." }, class: "bb-btn-sm bb-btn-danger w-full" %>
          </div>
        </div>
      </div>

      <!-- Main Image Display -->
      <div class="bb-main--wide order-1 lg:order-2">
        <div class="bb-card bb-card--panel">
          <div class="flex justify-center">
            <%= link_to view_image_path(@image, @image.image_file.filename) do %>
              <%= generate_image_tag(@image, [1000]) %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
