<%# Inner UI for the `dropzone` controller (the controller + data-values live on
    the surrounding card). Click-to-browse target, upload status, hidden input. %>
<div data-dropzone-target="prompt" data-action="click->dropzone#open"
     class="cursor-pointer border-2 border-dashed border-gray-300 rounded-lg p-4 mb-4 text-center text-gray-500 hover:border-blue-400 hover:text-blue-600 transition-colors">
  <span class="text-xl">⬆</span>
  <span class="text-sm ml-1">Drag images here, or click to browse</span>
</div>
<div data-dropzone-target="status" class="hidden text-center text-sm text-blue-700 mb-4 font-medium"></div>
<input type="file" multiple accept="image/*" class="hidden"
       data-dropzone-target="input" data-action="change->dropzone#picked">
