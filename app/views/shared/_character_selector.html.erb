<div data-controller="filter">
  <div class="bb-field">
    <!-- Label -->
    <label class="bb-label" for="character-search-<%= unique_id %>">Characters (<%= characters.count %>)</label>

    <!-- Search Input -->
    <div class="bb-field">
      <input class="bb-input" type="text" id="character-search-<%= unique_id %>" placeholder="Search characters..."
             data-filter-target="query" data-action="input->filter#apply">
    </div>

    <!-- Character List -->
    <div data-character-results class="max-h-80 overflow-y-auto border border-neutral-200 rounded-md bg-neutral-100">
      <% characters.sort_by(&:name).each do |character| %>
        <div data-filter-target="item" class="bb-list-item--bordered">
          <%= link_to character.name, character_path(character), class: "bb-link" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
