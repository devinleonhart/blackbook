<%# Navigation links shared by the desktop and mobile menus. `mobile` toggles
    the full-width styling; the links and their conditions are defined once. %>
<% link_class = mobile ? "bb-nav-link block w-full" : "bb-nav-link" %>

<% if @universe && @trait.nil? %>
  <%= link_to "New Character", new_universe_character_url(@universe), class: link_class %>
  <%= link_to "Edit Universe", edit_universe_url(@universe), class: link_class %>
<% end %>

<% if @character && @trait.nil? %>
  <%= link_to "Edit Character", edit_character_url(@character), class: link_class %>
<% end %>

<% if admin? %>
  <%= link_to "Admin", admin_root_path, class: link_class %>
<% end %>

<% if user_signed_in? %>
  <%= link_to "Random", random_image_path, data: { turbo: false }, class: link_class %>
  <%= link_to "Slideshow", slideshow_path, class: link_class %>
  <%= link_to "Favorites", favorites_path, class: link_class %>
  <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: link_class %>
<% else %>
  <%= link_to "Register", new_user_registration_path, class: link_class %>
  <%= link_to "Sign in", new_user_session_path, class: link_class %>
<% end %>
