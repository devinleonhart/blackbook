<div>
  <!-- Header -->
  <div class="flex items-center justify-between mb-4">
    <h3 class="bb-subheading mb-0">Traits</h3>
  </div>

  <% if @traits.any? %>
    <!-- Tag List -->
    <div class="space-y-2">
      <% @traits.each do |trait_name, count| %>
        <div class="group relative">
          <%= link_to trait_path(@trait_name_to_id[trait_name]), class: "bb-tag-btn" do %>
            <span class="truncate flex-1"><%= trait_name %></span>
            <span class="ml-2 bb-badge bb-badge-brand">
              <%= count %>
            </span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bb-empty-state text-neutral-500">
      <svg class="mx-auto h-12 w-12 text-neutral-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      <p class="text-sm">No traits yet</p>
      <p class="text-xs mt-1">Traits will appear as you add them to characters</p>
    </div>
  <% end %>
</div>
