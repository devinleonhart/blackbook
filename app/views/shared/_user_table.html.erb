<% if users.empty? %>
  <!-- Empty State -->
  <div class="bb-empty-state">
    <div class="bb-avatar-lg bb-avatar-neutral mx-auto mb-4">
      <span class="text-2xl">👥</span>
    </div>
    <h3 class="bb-empty-state__title">No users found</h3>
    <p class="bb-empty-state__text">There are currently no users in the system</p>
  </div>
<% else %>
  <!-- User List -->
  <div class="space-y-3">
    <h3 class="bb-subheading-sm">System Users</h3>
    <% users.each do | user | %>
      <!-- User Row -->
      <div class="bb-list-item">
        <div class="flex items-center">
          <div class="bb-avatar bb-avatar-brand mr-4">
            <span>👤</span>
          </div>
          <div class="flex flex-col">
            <span class="text-neutral-900 font-medium">
              <%= user.display_name %>
              <% if user.admin %>
                <span class="bb-badge bb-badge-brand ml-1">Admin</span>
              <% end %>
            </span>
            <span class="bb-subtitle-sm"><%= user.email %></span>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <span class="bb-badge bb-badge-neutral">
            <%= pluralize(universe_counts.fetch(user.id, 0), 'universe') %> • <%= pluralize(image_counts.fetch(user.id, 0), 'image') %>
          </span>
          <%= button_to (user.admin ? "Revoke admin" : "Make admin"), toggle_admin_user_path(user), method: :patch, class: "bb-btn-sm bb-btn-secondary" %>
          <%= link_to user_path(user.id), data: { turbo_method: :delete, turbo_confirm: "Delete #{user.display_name} (#{user.email})? This permanently removes their account." }, class: "bb-action-text p-2 hover:bg-neutral-200 rounded-full" do %>
            <span>🗑️</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
