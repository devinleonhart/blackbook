<%# Star button overlaid on a grid thumbnail. Submits via Turbo, so favoriting
    happens in place — ImagesController#update answers with a turbo_stream that
    replaces this element with its new state. Locals: image, universe, favorited. %>
<%= button_to universe_image_path(universe, image),
      method: :patch,
      params: { image: { favorite: !favorited } },
      form: { id: "favorite_toggle_#{image.id}" },
      class: "bb-fav-toggle #{'bb-fav-toggle--on' if favorited}",
      aria: { label: favorited ? "Unfavorite image" : "Favorite image", pressed: favorited },
      title: favorited ? "Unfavorite" : "Favorite" do %>
  <span aria-hidden="true"><%= favorited ? "★" : "☆" %></span>
<% end %>
