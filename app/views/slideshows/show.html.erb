<section id="slideshows-show-view" class="bb-page">

  <div class="bb-container-lg">
    <% unless @has_images %>
      <div class="bb-card bb-card--panel">
        <%= render partial: "shared/empty_banner", locals: { message: (@mode == "favorites" ? "No favorite images yet. Favorite an image to see it here." : "No images available for slideshow.") } %>
      </div>
    <% else %>
      <div
        class="bb-slideshow-shell"
        data-controller="slideshow"
        data-slideshow-slides-url-value="<%= slideshow_images_path(mode: @mode, universe_id: @universe_id, trait_names: @trait_names.presence) %>"
        data-slideshow-interval-ms-value="3000"
      >
        <!-- Top controls -->
        <div class="bb-slideshow-controls bb-slideshow-controls--top" data-slideshow-target="topControls">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2">
              <%= form_with url: slideshow_path, method: :get, class: "flex items-center" do %>
                <%= hidden_field_tag :mode, @mode %>
                <%= select_tag :universe_id,
                               options_for_select([["All universes", nil]] + @universes.map { |u| [u.name, u.id] }, @universe_id),
                               id: "slideshow_universe_id",
                               class: "bb-input w-auto",
                               aria: { label: "Universe" },
                               data: { controller: "autosubmit", action: "change->autosubmit#submit" } %>
              <% end %>

              <%= link_to "All",
                          slideshow_path(mode: "all", universe_id: @universe_id),
                          class: "bb-btn-sm #{@mode == "favorites" ? "bb-btn-outline" : "bb-btn-primary"}" %>
              <%= link_to "Favorites",
                          slideshow_path(mode: "favorites", universe_id: @universe_id),
                          class: "bb-btn-sm #{@mode == "favorites" ? "bb-btn-primary" : "bb-btn-outline"}" %>
              <button type="button" class="bb-btn-sm bb-btn-outline" data-action="slideshow#prev">Prev</button>
              <button type="button" class="bb-btn-sm bb-btn-primary" data-action="slideshow#togglePlay" data-slideshow-target="playButton">Play</button>
              <button type="button" class="bb-btn-sm bb-btn-outline" data-action="slideshow#next">Next</button>
              <button type="button" class="bb-btn-sm bb-btn-outline" data-action="slideshow#toggleFullscreen" data-slideshow-target="fullscreenButton">Fullscreen</button>
              <button type="button" class="bb-btn-sm bb-btn-outline" data-action="slideshow#toggleFavorite" data-slideshow-target="favoriteButton" title="Favorite (f)">☆ Favorite</button>
              <%= link_to "Open ↗", "#", target: "_blank", rel: "noopener", class: "bb-btn-sm bb-btn-outline", data: { slideshow_target: "detailLink" }, title: "Open detail (o)" %>
            </div>

            <span class="text-sm text-gray-700" data-slideshow-target="counter"></span>
          </div>
        </div>

        <!-- Stage -->
        <div
          class="bb-slideshow-stage bb-slideshow-stage--default"
          data-slideshow-target="stage"
          data-action="click->slideshow#stageTapped"
          tabindex="0"
        >
          <img data-slideshow-target="layerA" src="" alt="Slideshow image" class="bb-slideshow-layer bb-slideshow-layer--front" />
          <img data-slideshow-target="layerB" src="" alt="" aria-hidden="true" class="bb-slideshow-layer" />

          <div data-slideshow-target="loading" class="absolute inset-0 flex items-center justify-center text-white text-sm bg-black/40">
            Loading…
          </div>

          <div data-slideshow-target="error" class="hidden absolute top-4 left-1/2 -translate-x-1/2 bg-red-600/90 text-white text-sm px-3 py-2 rounded">
            <span data-slideshow-target="errorText">Failed to load slideshow.</span>
          </div>

          <div data-slideshow-target="fullscreenHint" class="hidden absolute top-4 left-1/2 -translate-x-1/2 bg-black/60 text-white text-sm px-3 py-2 rounded">
            Fullscreen — press Esc to exit
          </div>
        </div>

        <!-- Bottom controls (sit under the image, so the trait filter never pushes it down) -->
        <div class="bb-slideshow-controls bb-slideshow-controls--bottom" data-slideshow-target="bottomControls">
          <div class="flex items-center justify-between">
            <label class="text-sm font-medium text-gray-700" for="slideshow_speed">Speed</label>
            <span class="text-sm text-gray-700 w-16 text-right" data-slideshow-target="speedLabel">3.0s</span>
          </div>
          <input id="slideshow_speed" type="range" min="1" max="300" step="1" value="3" class="w-full mt-2" data-action="input->slideshow#speedChanged" data-slideshow-target="speed" />

          <!-- Trait filter: cycle through only images featuring a character with one of these traits. -->
          <% if @universe_id %>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <% if @available_trait_names.any? %>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-medium text-gray-700 mr-1">Traits:</span>
                  <% @available_trait_names.each_with_index do |trait_name, index| %>
                    <label class="bb-slideshow-chip">
                      <%= check_box_tag "trait_names[]", trait_name, @trait_names.include?(trait_name),
                            id: "slideshow_trait_#{index}",
                            class: "sr-only bb-slideshow-chip__input",
                            data: { slideshow_target: "trait", action: "change->slideshow#traitChanged" } %>
                      <span><%= trait_name %></span>
                    </label>
                  <% end %>
                  <button type="button" class="bb-link text-sm" data-action="slideshow#clearTraits">Clear</button>
                </div>
              <% else %>
                <p class="bb-subtitle-sm">This universe has no traits to filter by yet.</p>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
