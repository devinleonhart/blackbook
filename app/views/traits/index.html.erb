<section id="traits-index-view" class="bb-page--transparent">


  <div class="bb-container-md">
    <div class="bb-card bb-card--panel">

      <% if @traits.any? %>
        <!-- Tags Grid -->
        <div class="bb-card-grid">
          <% @traits.each do |tag| %>
            <!-- Tag Card -->
            <div class="bg-neutral-50 rounded-lg p-6 hover:bg-neutral-100 transition-colors duration-200 shadow-sm hover:shadow-md">
              <div class="flex items-center justify-between mb-4">
                <h3 class="bb-section-heading--sm mb-0">
                  <%= link_to tag.name, trait_path(tag), class: "hover:text-brand-600 hover:underline" %>
                </h3>
              </div>
              <div class="flex gap-3 justify-end">
                <%= link_to "Edit", edit_trait_path(tag), class: "text-brand-600 hover:text-brand-800 text-sm font-medium px-3 py-1 rounded hover:bg-neutral-200 transition-colors duration-200" %>
                <%= form_with url: trait_path(tag), method: :delete, local: true, class: "inline" do |form| %>
                  <%= form.submit "Delete", class: "text-danger-600 hover:text-danger-800 text-sm font-medium px-3 py-1 rounded hover:bg-neutral-200 transition-colors duration-200 bg-transparent border-none cursor-pointer", data: { turbo_confirm: "Remove the \"#{tag.name}\" trait from #{@character.name}?" } %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="bb-empty-state-lg">
          <p class="bb-subtitle text-lg">No traits yet for this character.</p>
        </div>
      <% end %>

      <!-- Back Link -->
      <div class="mt-12 pt-6">
        <%= link_to "← Back to #{@character.name}", character_path(@character), class: "bb-btn-sm bb-btn-secondary" %>
      </div>

    </div>
  </div>

</section>
