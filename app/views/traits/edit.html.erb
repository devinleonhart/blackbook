<section id="traits-edit-view" class="bb-page--transparent">


  <div class="bb-container-md">
    <div class="bb-card bb-card--panel-lg">

      <!-- Trait Form -->
      <%= form_with model: [@character, @trait], url: trait_path(@trait), method: :patch, class: "space-y-8" do |form| %>

        <!-- Error Messages -->
        <% if @trait.errors.any? %>
          <div class="bb-alert bb-alert-error">
            <h4 class="font-bold text-lg mb-3">Please fix the following errors:</h4>
            <ul class="list-disc list-inside space-y-1">
              <% @trait.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <!-- Name Field -->
        <div class="space-y-3">
          <%= form.label :name, "Trait name", class: "bb-label-lg" %>
          <%= form.text_field :name, placeholder: "Enter trait name...", class: "bb-input-lg" %>
          <p class="bb-subtitle-sm">Traits are saved in lowercase</p>
        </div>

        <!-- Actions -->
        <div class="flex gap-4 pt-4">
          <%= form.submit "Update trait", class: "bb-btn bb-btn-primary shadow-sm hover:shadow-md" %>
          <%= link_to "Cancel", character_path(@character), class: "bb-btn bb-btn-secondary shadow-sm hover:shadow-md" %>
        </div>

      <% end %>

    </div>
  </div>

</section>
