<section id="users-index-view" class="bb-page">

  <div class="bb-container-md">

    <!-- Back Link -->
    <div class="mb-6">
      <%= link_to "← Back to Admin", admin_root_path, class: "bb-link-strong" %>
    </div>

    <div class="flex justify-center">
      <div class="w-full">

        <!-- Page Header -->
        <div class="bb-page-header">
          <h1 class="bb-heading-xl">User Management</h1>
          <p class="bb-subtitle">Manage system users and permissions</p>
        </div>

        <div class="mb-4 flex justify-end">
          <%= link_to "+ New universe", new_universe_path, class: "bb-btn-sm bb-btn-primary" %>
        </div>

        <!-- User Table -->
        <div class="bb-card bb-card--form">
          <%= render partial: "shared/user_table", locals: {
            users: @users,
            universe_counts: @universe_counts,
            image_counts: @image_counts
          } %>
        </div>

      </div>
    </div>
  </div>

</section>
