<section id="universes-new-view" class="bb-page">

  <div class="bb-container-xs">
    <div class="flex justify-center">
      <div class="w-full">

        <!-- Page Header -->
        <div class="bb-page-header">
          <h1 class="bb-heading-xl">Create New Universe</h1>
          <p class="bb-subtitle">Create a universe and assign it to a user</p>
        </div>

        <!-- Universe Form -->
        <%= form_with model: @new_universe, url: universes_url, method: "post", html: { class: "bb-card bb-card--form" } do |form| %>

          <!-- Name Field -->
          <div class="bb-field-lg">
            <%= form.label :name, class: "bb-label" %>
            <div class="bb-input-icon-wrapper">
              <span class="bb-input-icon">🚀</span>
              <%= form.text_field :name, class: "bb-input-lg pl-10 pr-3", placeholder: "Enter universe name", required: true %>
            </div>
          </div>

          <!-- Owner Field -->
          <div class="bb-field-lg">
            <%= form.label :owner_id, "Owner", class: "bb-label" %>
            <%= form.select :owner_id,
                            options_for_select(@users.map { |u| ["#{u.display_name} (#{u.email})", u.id] }),
                            { include_blank: "Select an owner…" },
                            class: "bb-input", required: true %>
          </div>

          <!-- Actions -->
          <div class="flex flex-col sm:flex-row gap-3">
            <%= form.submit "Create Universe", class: "bb-btn bb-btn-primary bb-btn--flex" %>
            <%= link_to "Cancel", users_url, class: "bb-btn bb-btn-secondary bb-btn--flex text-center" %>
          </div>

        <% end %>

      </div>
    </div>
  </div>

</section>
