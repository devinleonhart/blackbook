<section id="universes-index-view" class="bb-page">

  <div class="bb-container-md">
    <div class="flex justify-center">
      <div class="w-full">

        <!-- Page Header -->
        <div class="bb-page-header">
          <h1 class="bb-heading-xl">Your Universes</h1>
        </div>

        <!-- Universe List -->
        <div class="bb-card bb-card--form">
          <% if @universes.empty? %>
            <!-- Empty State -->
            <div class="bb-empty-state">
              <h3 class="bb-empty-state__title">No universes yet</h3>
              <% if admin? %>
                <p class="bb-empty-state__text">Create a universe and assign it to a user from the admin area.</p>
                <div class="mt-4"><%= link_to "New universe", new_universe_path, class: "bb-btn-sm bb-btn-primary" %></div>
              <% else %>
                <p class="bb-empty-state__text">You don't have any universes yet. Ask an admin to set one up for you.</p>
              <% end %>
            </div>
          <% else %>
            <div class="space-y-3">
              <% @universes.each do | universe | %>
                <%= link_to universe_path(universe), class: "block" do %>
                  <div class="bb-list-item">
                    <div class="flex items-center">
                      <div class="flex flex-col">
                        <span class="text-neutral-900 font-medium"><%= universe.name %></span>
                        <span class="bb-subtitle-sm">
                          <%= pluralize(@character_counts.fetch(universe.id, 0), 'character') %> • <%= pluralize(@image_counts.fetch(universe.id, 0), 'image') %>
                        </span>
                      </div>
                    </div>
                    <div class="flex items-center">
                      <div class="text-brand-600 p-2 rounded-full">
                        <span>→</span>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>

      </div>
    </div>
  </div>

</section>
