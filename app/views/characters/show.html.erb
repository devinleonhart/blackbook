<section id="characters-show-view" class="bb-page">


  <div class="bb-container">
    <div class="bb-layout-sidebar">
      <!-- Left Sidebar - Traits -->
      <div class="bb-sidebar order-1 lg:order-1" data-controller="collapse">
        <!-- Collapsed on small screens so the character's images stay near the top. -->
        <button type="button"
                class="lg:hidden bb-btn bb-btn-secondary w-full flex items-center justify-between mb-3"
                data-action="collapse#toggle"
                data-collapse-target="button"
                aria-expanded="false">
          <span>Traits</span>
          <span data-collapse-target="icon" class="transition-transform duration-200">▾</span>
        </button>

        <div data-collapse-target="content" class="hidden lg:block">
          <div class="bb-card bb-card--panel">
            <!-- Upload images that include this character -->
            <%= render "shared/dropzone", url: universe_images_url(@character.universe), character_id: @character.id %>
            <p class="bb-subtitle-sm text-center mt-2 mb-6">New images will include <%= @character.name %>.</p>

            <hr class="bb-divider" />

            <div data-controller="filter">
              <h2 class="bb-section-heading bb-section-heading--center">Traits</h2>

              <!-- Current traits: name links to a browse; × removes it from this character -->
              <div class="mb-6">
                <% if @character.traits.empty? %>
                  <p class="bb-subtitle-sm">No traits yet</p>
                <% else %>
                  <div class="flex flex-wrap gap-2">
                    <% @character.traits.order(:name).each do |trait| %>
                      <span class="bb-pill bb-pill-brand inline-flex items-center gap-1">
                        <%= link_to trait.name, trait_path(trait), class: "hover:underline" %>
                        <%= button_to "×", trait_path(trait), method: :delete,
                              data: { turbo_confirm: "Remove the \"#{trait.name}\" trait from #{@character.name}?" },
                              class: "leading-none text-brand-600 hover:text-danger-600 bg-transparent border-none cursor-pointer p-0" %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Add a trait: type to find an existing one or create a new one -->
              <div>
                <%= form_with model: [@character, @character.traits.build], url: character_traits_path(@character), method: :post, class: "mb-3" do |form| %>
                  <div class="flex gap-2">
                    <%= form.text_field :name, placeholder: "Type to find or create…",
                          data: { filter_target: "query", action: "input->filter#apply" }, class: "bb-input text-sm" %>
                    <%= form.submit "Add", class: "bb-btn-sm bb-btn-primary" %>
                  </div>
                <% end %>

                <% if @available_trait_names.any? %>
                  <div class="flex flex-wrap gap-1">
                    <% @available_trait_names.each do |trait_name| %>
                      <div data-filter-target="item" data-filter-text="<%= trait_name %>">
                        <%= form_with model: [@character, @character.traits.build], url: character_traits_path(@character), method: :post, class: "inline" do |form| %>
                          <%= form.hidden_field :name, value: trait_name %>
                          <%= form.submit trait_name, class: "text-xs bg-neutral-100 hover:bg-neutral-200 text-neutral-700 px-2 py-1 rounded transition-colors duration-200 cursor-pointer" %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% elsif @universe_trait_names.any? %>
                  <p class="bb-subtitle-sm mt-2">Every trait in this universe is already on this character.</p>
                <% end %>
              </div>

              <div class="mt-6">
                <%= link_to "Manage traits", character_traits_path(@character), class: "bb-link text-sm font-medium" %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content - Images -->
      <div class="bb-main order-2 lg:order-2">
        <div class="bb-card bb-card--panel">
          <h1 class="text-3xl font-bold text-neutral-800 mb-6 text-center"><%= @character.name %></h1>
          <%= render partial: "shared/image_list", locals: {
            images: @images,
            universe: @character.universe,
            character: @character
          } %>
        </div>
      </div>
    </div>
  </div>

</section>
