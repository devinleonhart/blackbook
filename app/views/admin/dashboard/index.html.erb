<section id="admin-dashboard-view" class="bb-page">
  <div class="max-w-5xl mx-auto px-4">
    <div class="mb-8">
      <h1 class="bb-heading-xl">Admin</h1>
      <p class="bb-subtitle">Administrative tools for managing the system.</p>
    </div>

    <!-- At-a-glance stats -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
      <% [
           ["Users", number_with_delimiter(@stats[:users])],
           ["Universes", number_with_delimiter(@stats[:universes])],
           ["Characters", number_with_delimiter(@stats[:characters])],
           ["Images", number_with_delimiter(@stats[:images])],
           ["Storage", number_to_human_size(@stats[:storage])],
           ["Duplicate groups", number_with_delimiter(@stats[:duplicate_groups])]
         ].each do |label, value| %>
        <div class="bb-card bb-card--panel bb-card--bordered text-center">
          <div class="text-2xl font-bold text-gray-900"><%= value %></div>
          <div class="bb-subtitle-sm"><%= label %></div>
        </div>
      <% end %>
    </div>

    <div class="bb-card-grid-2">
      <!-- User management -->
      <div class="bb-card bb-card--panel bb-card--bordered">
        <h2 class="bb-section-heading--sm mb-2">User management</h2>
        <p class="bb-subtitle-sm mb-4">View and manage users, permissions, and ownership.</p>
        <%= link_to "Open user management →", users_path, class: "bb-link-strong" %>
      </div>

      <!-- Dedupe -->
      <div class="bb-card bb-card--panel bb-card--bordered">
        <h2 class="bb-section-heading--sm mb-2">Dedupe</h2>
        <p class="bb-subtitle-sm mb-4">Find duplicate image uploads.</p>
        <%= link_to "Find duplicate images →", admin_dedupe_images_path, class: "bb-link-strong" %>
      </div>

      <!-- Create universe -->
      <div class="bb-card bb-card--panel bb-card--bordered">
        <h2 class="bb-section-heading--sm mb-2">Create universe</h2>
        <p class="bb-subtitle-sm mb-4">Create a new universe and assign it to a user.</p>
        <%= link_to "New universe →", new_universe_path, class: "bb-link-strong" %>
      </div>
    </div>
  </div>
</section>
